MYSQL_DSN=app:app_password@tcp(127.0.0.1:3307)/user_order_api?parseTime=true&charset=utf8mb4&loc=UTC
MYSQL_TEST_DSN=app:app_password@tcp(127.0.0.1:3307)/user_order_api_test?parseTime=true&charset=utf8mb4&loc=UTC
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes-in-production
JWT_ISSUER=user-order-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
# 生产必须为 true；本地 HTTP 开发时才显式设为 false。
AUTH_COOKIE_SECURE=false
# CORS_ALLOWED_ORIGINS=https://app.example.com
# TRUSTED_PROXY_CIDRS=10.0.0.0/8
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=120
